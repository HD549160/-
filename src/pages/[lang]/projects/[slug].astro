---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projects, text, type Project } from '@/data/projects';
import { languages, assetPath, pathFor, t, type Lang } from '@/lib/i18n';

export async function getStaticPaths() {
  const entries = await getCollection('cases');
  return languages.flatMap((lang) => projects.map((project) => ({
    params: { lang, slug: project.id },
    props: { lang, project, entry: entries.find((item) => item.data.lang === lang && item.data.projectId === project.id) }
  })));
}

const { lang, project, entry } = Astro.props as { lang: Lang; project: Project; entry?: Awaited<ReturnType<typeof getCollection<'cases'>>>[number] };
const strings = t(lang);
const rendered = entry ? await entry.render() : null;
const Content = rendered?.Content;
const index = projects.findIndex((item) => item.id === project.id);
const next = projects[(index + 1) % projects.length];
const facts = [
  [strings.labels.status, text(project.facts.status, lang)],
  [strings.labels.evidence, text(project.facts.evidence, lang)],
  [strings.labels.validation, text(project.facts.validation, lang)],
  ...(project.facts.role ? [[strings.labels.role, text(project.facts.role, lang)]] : []),
  ...(project.facts.team ? [[strings.labels.team, text(project.facts.team, lang)]] : []),
  ...(project.facts.time ? [[strings.labels.time, text(project.facts.time, lang)]] : [])
];
---
<BaseLayout lang={lang} title={`${text(project.title, lang)} · ${lang === 'zh' ? '黄丹' : 'Huang Dan'}`} description={text(project.summary, lang)} image={project.cover}>
  <header class="project-hero shell">
    <a class="back-link" href={pathFor(lang, 'work/')}>← {strings.actions.back}</a>
    <div class="project-title" data-reveal>
      <div>
        <p class="section-index">{project.number} / {project.deep ? strings.labels.deepCase : strings.labels.archive}</p>
        <h1>{text(project.title, lang)}</h1>
        <p class="subtitle">{text(project.subtitle, lang)}</p>
      </div>
      <p class="summary">{text(project.summary, lang)}</p>
    </div>
    <figure class="hero-image" data-reveal><img src={assetPath(project.cover)} alt={text(project.subtitle, lang)} decoding="async" /></figure>
  </header>

  <section class="facts shell" aria-label={lang === 'zh' ? '项目信息' : 'Project facts'}>
    {facts.map(([label, value]) => <div><span>{label}</span><p>{value}</p></div>)}
  </section>

  {project.deep && Content ? (
    <section class="case-body shell">
      <aside class="case-nav">
        <p>{lang === 'zh' ? '案例结构' : 'Case structure'}</p>
        <ol>
          <li><a href="#context">01 {lang === 'zh' ? '背景与挑战' : 'Context'}</a></li>
          <li><a href="#insight">02 {lang === 'zh' ? '研究与洞察' : 'Insights'}</a></li>
          <li><a href="#strategy">03 {lang === 'zh' ? '产品策略' : 'Strategy'}</a></li>
          <li><a href="#solution">04 {lang === 'zh' ? '核心方案' : 'Solution'}</a></li>
          <li><a href="#validation">05 {lang === 'zh' ? '验证计划' : 'Validation'}</a></li>
          <li><a href="#reflection">06 {lang === 'zh' ? '反思' : 'Reflection'}</a></li>
        </ol>
      </aside>
      <article class="prose" data-reveal><Content /></article>
    </section>
  ) : (
    <section class="short-intro shell" data-reveal>
      <p class="section-index">01 / OVERVIEW</p>
      <h2>{lang === 'zh' ? '项目摘要' : 'Project summary'}</h2>
      <p>{text(project.summary, lang)}</p>
      <ul class="tag-list">{project.tags[lang].map((tag) => <li>{tag}</li>)}</ul>
    </section>
  )}

  <section id="complete-project" class="portfolio-pages shell">
    <div class="portfolio-pages-heading">
      <div>
        <p class="section-index">{project.deep ? '07' : '02'} / COMPLETE PROJECT</p>
        <h2>{lang === 'zh' ? '完整项目展板' : 'Complete project boards'}</h2>
      </div>
      <p>{lang === 'zh' ? `以下按原作品集顺序完整展示，共 ${project.pages.length} 页。每页独占一行，点击图片可查看 2400 × 1350 高清原图。` : `Shown below in the original portfolio order, ${project.pages.length} pages in total. Each board occupies its own row; open any image for the 2400 × 1350 original.`}</p>
    </div>
    <div class="page-stack">
      {project.pages.map((page, pageIndex) => {
        const pageNumber = String(page).padStart(2, '0');
        const src = assetPath(`assets/pages/page-${pageNumber}.webp`);
        const alt = lang === 'zh' ? `${text(project.title, lang)}项目展板第${pageIndex + 1}页，原作品集第${page}页` : `${text(project.title, lang)} project board ${pageIndex + 1}, source portfolio page ${page}`;
        return (
          <figure class="portfolio-page" data-reveal>
            <div class="page-label"><span>{String(pageIndex + 1).padStart(2, '0')}</span><p>{lang === 'zh' ? `项目第 ${pageIndex + 1} 页 · 原作品集第 ${page} 页` : `Project page ${pageIndex + 1} · Source page ${page}`}</p><a href={src} target="_blank" rel="noreferrer">{lang === 'zh' ? '打开高清原图 ↗' : 'Open full resolution ↗'}</a></div>
            <a class="page-image" href={src} target="_blank" rel="noreferrer" aria-label={lang === 'zh' ? `打开${alt}` : `Open ${alt}`}>
              <img src={src} alt={alt} loading={pageIndex < 1 ? 'eager' : 'lazy'} decoding="async" />
              <span>{lang === 'zh' ? '点击放大' : 'Open full size'}</span>
            </a>
          </figure>
        );
      })}
    </div>
  </section>

  <nav class="next-project" aria-label={lang === 'zh' ? '下一个项目' : 'Next project'}>
    <a class="shell" href={pathFor(lang, `projects/${next.id}/`)}>
      <span>{strings.actions.next}</span>
      <strong>{text(next.title, lang)}</strong>
      <i aria-hidden="true">→</i>
    </a>
  </nav>
</BaseLayout>

<style>
  .project-hero { padding: 50px 0 76px; }
  .back-link { display: inline-block; margin-bottom: 72px; color: var(--muted); font-size: .88rem; }
  .project-title { display: grid; grid-template-columns: 1.15fr .85fr; gap: 80px; align-items: end; }
  .project-title h1 { margin: 0 0 14px; }
  .subtitle { color: var(--muted); font-size: clamp(1.15rem, 2vw, 1.45rem); }
  .summary { max-width: 50ch; color: var(--muted); font-size: 1.05rem; }
  .hero-image { margin: 58px 0 0; overflow: hidden; border-radius: 12px; background: var(--soft); }
  .hero-image img { width: 100%; max-height: 720px; object-fit: cover; }
  .facts { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .facts div { padding: 28px; border-right: 1px solid var(--line); }
  .facts div:last-child { border-right: 0; }
  .facts span { color: var(--blue); font-size: .7rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .facts p { margin: 12px 0 0; color: var(--muted); font-size: .88rem; }
  .case-body { display: grid; grid-template-columns: 220px minmax(0, 760px); justify-content: space-between; gap: 80px; padding-block: 110px; }
  .case-nav { position: sticky; top: 112px; align-self: start; }
  .case-nav > p { font-weight: 800; }
  .case-nav ol { list-style: none; margin: 0; padding: 14px 0 0; border-top: 1px solid var(--line); }
  .case-nav li { margin: 11px 0; }
  .case-nav a { color: var(--muted); font-size: .82rem; }
  .case-nav a:hover { color: var(--blue); }
  .prose :global(h2) { scroll-margin-top: 110px; margin: 90px 0 24px; padding-top: 26px; border-top: 1px solid var(--line); font-size: clamp(2rem, 4vw, 3.4rem); }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { margin: 42px 0 15px; font-size: 1.35rem; }
  .prose :global(p), .prose :global(li) { color: var(--muted); font-size: 1rem; }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(blockquote) { margin: 34px 0; padding: 24px 26px; border-left: 3px solid var(--blue); background: var(--soft); }
  .prose :global(blockquote p) { margin: 0; color: var(--ink); font-size: 1.12rem; }
  .short-intro { padding-block: 100px; max-width: 900px; }
  .short-intro h2 { margin-bottom: 24px; }
  .short-intro > p:not(.section-index) { max-width: 58ch; color: var(--muted); font-size: 1.08rem; }
  .portfolio-pages { padding-bottom: 120px; }
  .portfolio-pages-heading { display: grid; grid-template-columns: 1fr minmax(280px, .65fr); gap: 50px; align-items: end; padding-top: 34px; margin-bottom: 54px; border-top: 1px solid var(--line); }
  .portfolio-pages-heading h2 { margin-bottom: 0; }
  .portfolio-pages-heading > p { margin: 0; color: var(--muted); }
  .page-stack { display: grid; gap: 72px; }
  .portfolio-page { margin: 0; }
  .page-label { display: grid; grid-template-columns: 44px 1fr auto; gap: 14px; align-items: center; margin-bottom: 14px; }
  .page-label span { color: var(--blue); font-weight: 800; }
  .page-label p { margin: 0; color: var(--muted); font-size: .88rem; }
  .page-label a { color: var(--blue); font-size: .82rem; font-weight: 750; }
  .page-image { position: relative; display: block; width: 100%; overflow: hidden; border: 1px solid var(--line); background: white; box-shadow: 0 18px 55px rgba(16,27,43,.08); }
  .page-image img { width: 100%; height: auto; }
  .page-image > span { position: absolute; right: 16px; bottom: 16px; padding: 8px 11px; border-radius: 5px; background: rgba(16,27,43,.88); color: white; font-size: .75rem; opacity: 0; transition: opacity .18s ease; }
  .page-image:hover > span, .page-image:focus-visible > span { opacity: 1; }
  .next-project { border-top: 1px solid var(--line); }
  .next-project a { min-height: 210px; display: grid; grid-template-columns: 1fr auto; grid-template-rows: auto 1fr; gap: 8px 30px; align-items: center; padding-block: 52px; }
  .next-project span { color: var(--muted); }
  .next-project strong { font-size: clamp(2rem, 5vw, 4.6rem); letter-spacing: -.04em; }
  .next-project i { grid-row: 1 / span 2; grid-column: 2; font-size: 3rem; color: var(--blue); font-style: normal; }
  @media (max-width: 840px) { .project-title, .case-body { grid-template-columns: 1fr; gap: 36px; } .case-nav { position: static; } .case-nav ol { display: flex; flex-wrap: wrap; gap: 6px 18px; } .facts { grid-template-columns: 1fr; } .facts div { border-right: 0; border-bottom: 1px solid var(--line); } .facts div:last-child { border-bottom: 0; } }
  @media (max-width: 620px) { .project-hero { padding-bottom: 52px; } .back-link { margin-bottom: 52px; } .hero-image { margin-top: 38px; } .case-body { padding-block: 78px; } .portfolio-pages { padding-bottom: 82px; } .portfolio-pages-heading { grid-template-columns: 1fr; gap: 20px; margin-bottom: 38px; } .page-stack { gap: 48px; } .page-label { grid-template-columns: 34px 1fr; } .page-label a { grid-column: 2; } .page-image { width: calc(100vw - 16px); margin-left: calc((var(--shell) - 100vw + 16px) / 2); overflow-x: auto; } .page-image img { width: 960px; max-width: none; } }
</style>
