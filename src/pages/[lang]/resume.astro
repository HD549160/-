---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { languages, pathFor, t, type Lang } from '@/lib/i18n';
import { profile, profileText } from '@/data/profile';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang }, props: { lang } })); }
const lang = Astro.props.lang as Lang;
const strings = t(lang);
const info = profileText(lang);
---
<BaseLayout lang={lang} title={`${strings.resume.title} · ${info.name}`} description={strings.resume.intro}>
  <section class="resume-shell shell">
    <div class="resume-toolbar no-print">
      <a href={pathFor(lang, 'about/')} class="text-link">← {strings.nav.about}</a>
      <div>
        <button class="button button-primary" type="button" onclick="window.print()">{strings.resume.print}</button>
        <a class="button button-secondary" href={pathFor(lang, 'work/')}>{strings.resume.portfolio}</a>
      </div>
    </div>
    <article class="resume" data-reveal>
      <header>
        <p class="section-index">PUBLIC RÉSUMÉ / 2026</p>
        <h1>{info.name}</h1>
        <p class="role">{lang === 'zh' ? '产品经理候选人 · 工业设计与信息交互背景' : 'Product manager candidate · Industrial design & information interaction'}</p>
        <p class="summary">{strings.hero.body}</p>
      </header>
      <section>
        <h2>{strings.about.education}</h2>
        <div class="resume-row"><span>2020 — {lang === 'zh' ? '至今' : 'Present'}</span><div><h3>{info.school}</h3><p>{info.degree}</p></div></div>
      </section>
      <section>
        <h2>{lang === 'zh' ? '代表项目' : 'Selected projects'}</h2>
        <div class="resume-projects">
          <div><span>01</span><h3>{lang === 'zh' ? '药你安全' : 'For Your Safety'}</h3><p>{lang === 'zh' ? '适老化用药安全服务系统：多角色需求、用户旅程、服务蓝图与软硬件协同。' : 'Medication safety service: multi-stakeholder needs, journey mapping, blueprint and hardware-software coordination.'}</p></div>
          <div><span>02</span><h3>{lang === 'zh' ? '籍光' : 'Jiguang'}</h3><p>{lang === 'zh' ? '代际交流 AI 应用概念：用户痛点、功能框架、界面与服务蓝图。' : 'AI-assisted intergenerational concept: user pain points, feature framework, interface and service blueprint.'}</p></div>
          <div><span>03</span><h3>Beeye</h3><p>{lang === 'zh' ? '外卖骑手智能头盔：高频场景、AR 导航、语音交互与结构设计。' : 'Smart delivery helmet: high-frequency contexts, AR navigation, voice interaction and structural design.'}</p></div>
        </div>
      </section>
      <section>
        <h2>{strings.about.awards}</h2>
        <ul>{info.awards.slice(0, 4).map((award) => <li>{award}</li>)}</ul>
      </section>
      <section>
        <h2>{strings.about.tools}</h2>
        <p>{profile.tools.join(' · ')}</p>
      </section>
      <footer>
        <p>{strings.resume.pending}</p>
      </footer>
    </article>
  </section>
</BaseLayout>

<style>
  .resume-shell { padding: 54px 0 110px; }
  .resume-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin-bottom: 28px; }
  .resume-toolbar > div { display: flex; gap: 10px; }
  .resume { max-width: 940px; margin: 0 auto; padding: clamp(34px, 6vw, 76px); border: 1px solid var(--line); background: white; box-shadow: 0 24px 70px rgba(16,27,43,.08); }
  .resume header { display: grid; grid-template-columns: 1fr .75fr; gap: 16px 44px; padding-bottom: 34px; border-bottom: 3px solid var(--ink); }
  .resume header .section-index, .resume header h1 { grid-column: 1; }
  .resume h1 { font-size: clamp(3.2rem, 8vw, 6rem); margin: 0; }
  .role { grid-column: 1; color: var(--blue); font-weight: 750; }
  .summary { grid-column: 2; grid-row: 1 / span 3; align-self: end; color: var(--muted); }
  .resume section { padding: 32px 0; border-bottom: 1px solid var(--line); }
  .resume section h2 { font-size: 1rem; letter-spacing: .08em; text-transform: uppercase; color: var(--blue); }
  .resume-row { display: grid; grid-template-columns: 180px 1fr; gap: 24px; }
  .resume-row span, .resume-projects span { color: var(--muted); font-size: .8rem; }
  .resume-row h3 { margin-bottom: 6px; }
  .resume-row p { color: var(--muted); }
  .resume-projects { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .resume-projects h3 { margin: 18px 0 8px; }
  .resume-projects p, .resume li, .resume section > p { color: var(--muted); font-size: .9rem; }
  .resume footer { padding-top: 28px; color: var(--muted); font-size: .82rem; }
  @media (max-width: 720px) { .resume-toolbar { align-items: flex-start; } .resume-toolbar > div { flex-direction: column; } .resume header { grid-template-columns: 1fr; } .summary { grid-column: 1; grid-row: auto; } .resume-row, .resume-projects { grid-template-columns: 1fr; } }
  @media print { .resume-shell { padding: 0; } .resume { max-width: none; border: 0; box-shadow: none; padding: 0; } }
</style>
