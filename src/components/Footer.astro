---
import type { Lang } from '@/lib/i18n';
import { pathFor, t } from '@/lib/i18n';
import { profile } from '@/data/profile';

const { lang } = Astro.props as { lang: Lang };
const strings = t(lang);
const year = new Date().getFullYear();
---
<section id="contact" class="contact-band">
  <div class="shell contact-grid">
    <div>
      <p class="section-index">05 / {strings.nav.contact}</p>
      <h2>{strings.sections.contact}</h2>
    </div>
    <div class="contact-actions">
      {profile.email ? <a class="button button-primary" href={`mailto:${profile.email}`}>{profile.email}</a> : <p class="pending-contact">{strings.resume.pending}</p>}
      {profile.github && <a class="text-link" href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a>}
      <a class="text-link" href={pathFor(lang, 'resume/')}>{strings.nav.resume} →</a>
    </div>
  </div>
</section>
<footer class="site-footer">
  <div class="shell footer-inner">
    <p>© {year} {lang === 'zh' ? '黄丹' : 'Huang Dan'}</p>
    <p>{strings.footer}</p>
    <a href="#main">{strings.actions.top} ↑</a>
  </div>
</footer>
